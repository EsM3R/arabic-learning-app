{
  "expo": {
    "name": "Lisan Hocası",
    "slug": "arapca-hoca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.esm3r.lisanhocasi",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B3D34",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Telaffuz pratiği için mikrofon erişimi gerekiyor."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Konuşma pratiği için mikrofon erişimi gerekiyor.",
          "speechRecognitionPermission": "Söylediklerini yazıya çevirip değerlendirebilmek için gerekiyor."
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "NotoNaskhArabic",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/NotoNaskhArabic-Regular.ttf",
                    "weight": 400,
                    "style": "normal"
                  },
                  {
                    "path": "./assets/fonts/NotoNaskhArabic-SemiBold.ttf",
                    "weight": 600,
                    "style": "normal"
                  }
                ]
              },
              {
                "fontFamily": "Fraunces",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Fraunces-Medium.ttf",
                    "weight": 500,
                    "style": "normal"
                  },
                  {
                    "path": "./assets/fonts/Fraunces-SemiBold.ttf",
                    "weight": 600,
                    "style": "normal"
                  }
                ]
              },
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope-Regular.ttf",
                    "weight": 400,
                    "style": "normal"
                  },
                  {
                    "path": "./assets/fonts/Manrope-Medium.ttf",
                    "weight": 500,
                    "style": "normal"
                  },
                  {
                    "path": "./assets/fonts/Manrope-SemiBold.ttf",
                    "weight": 600,
                    "style": "normal"
                  },
                  {
                    "path": "./assets/fonts/Manrope-Bold.ttf",
                    "weight": 700,
                    "style": "normal"
                  },
                  {
                    "path": "./assets/fonts/Manrope-ExtraBold.ttf",
                    "weight": 800,
                    "style": "normal"
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/NotoNaskhArabic-Regular.ttf",
              "./assets/fonts/NotoNaskhArabic-SemiBold.ttf",
              "./assets/fonts/Fraunces-Medium.ttf",
              "./assets/fonts/Fraunces-SemiBold.ttf",
              "./assets/fonts/Manrope-Regular.ttf",
              "./assets/fonts/Manrope-Medium.ttf",
              "./assets/fonts/Manrope-SemiBold.ttf",
              "./assets/fonts/Manrope-Bold.ttf",
              "./assets/fonts/Manrope-ExtraBold.ttf"
            ]
          }
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B3D34"
        }
      ]
    ],
    "backgroundColor": "#F6F1E7"
  }
}
